# ---------------------------------------------------------------
# Strivers' Hub - environment
# Copy to .env.local for development. Set the same keys in Vercel.
# ---------------------------------------------------------------

# Sanity project (public - safe to expose to the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=9znzy5bd
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Sanity write token. The running site does not need one: it only reads
# content, and people data lives in Postgres. Only `npm run seed` uses it,
# run once from a developer's machine. Create at sanity.io/manage with the
# "Editor" role, delete it when the seed is done, and never set it on the host.
SANITY_API_WRITE_TOKEN=

# Signing key for session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Public site URL, used for canonical tags, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.strivershub.com

# Set to 1 on anything that is not the live site - the client preview, a
# staging box, a review app. It turns robots.txt into a blanket disallow and
# adds an X-Robots-Tag: noindex header, so a preview cannot end up competing
# with the real site for its own content. Leave blank in production.
SITE_NOINDEX=

# Transactional mail, for the password-reset link. Without these the reset
# form still works and still reports success - the message is written to the
# server log instead of being delivered, so nothing 500s on a fresh
# environment. Set both to turn delivery on. The account is TAF's, per the
# scope of work; any provider will do, see src/lib/email.ts.
RESEND_API_KEY=
MAIL_FROM="Strivers' Hub <no-reply@strivershub.com>"

# Google Analytics 4 (optional - leave blank to disable)
NEXT_PUBLIC_GA_ID=

# The platform's database: TAF's Neon Postgres in production (a Neon branch,
# never production, for previews). Holds the members, assessment results and
# mentorship sign-ups in the previous platform's tables, plus the site's own
# small tables (analytics, rate limits, admin audit), which are created on
# first use. Required for accounts and forms.
DATABASE_URL=

# Password for /insights, the team's analytics dashboard. Leave blank and the
# dashboard stays closed. Share it only with the programme team.
INSIGHTS_PASSWORD=

# Who may use /admin, the programme team's view of accounts, assessment
# results and mentorship sign-ups (lists, Excel export, data requests).
# Comma-separated emails of ordinary site accounts: each person registers on
# the site as usual, then their email is added here. Leave blank and nobody
# can open /admin. Every export and data request is written to an audit log.
ADMIN_EMAILS=

# Shared secret for the Sanity publish webhook (header x-revalidate-secret).
# With it, published edits appear within seconds; without it, within the hour.
REVALIDATE_SECRET=
